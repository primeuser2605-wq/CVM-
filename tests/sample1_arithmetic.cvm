// sample1_arithmetic.cvm
// Demonstrates: variables, arithmetic, operator precedence.

a = 10;
b = 4;

print a + b;      // 14
print a - b;      // 6
print a * b;      // 40
print a / b;      // 2  (integer division)

// Precedence: * binds tighter than +
print 2 + 3 * 4;  // 14, not 20

// Parentheses override precedence
print (2 + 3) * 4; // 20
