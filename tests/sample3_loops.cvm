// sample3_loops.cvm
// Demonstrates: while loops, accumulators.

// Count from 1 to 5
i = 1;
while (i < 6) {
    print i;
    i = i + 1;
}

// Sum of 1..10
sum = 0;
n = 1;
while (n < 11) {
    sum = sum + n;
    n = n + 1;
}
print sum;        // 55

// Factorial of 6
k = 6;
fact = 1;
while (k > 1) {
    fact = fact * k;
    k = k - 1;
}
print fact;       // 720
